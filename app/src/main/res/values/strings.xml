    <!-- Settings -->
    <string name="section_reliability">RELIABILITY &amp; AUTOMATION</string>
    <string name="auto_reconnect_title">Auto-Reconnect</string>
    <string name="auto_reconnect_desc">Restore the tunnel automatically after network changes or SSH drops. Routed apps stay blocked while reconnecting, so nothing leaks.</string>
    <string name="boot_title">Auto-Start on Boot</string>
    <string name="boot_desc">Connect automatically when the device or Android TV boots up</string>
    <string name="section_network">NETWORK &amp; DNS</string>
    <string name="bypass_lan_title">Bypass Local Network (LAN)</string>
    <string name="bypass_lan_desc">Routed apps reach devices in your local network (NAS, DLNA, Chromecast, router) directly. Internet traffic still goes through SSH.</string>
    <string name="dns_title">Tunnel DNS Server: %1$s</string>
    <string name="dns_desc">DNS queries of routed apps are resolved by this server through the SSH tunnel (DNS over TCP). Use a public resolver: local addresses are not reachable from the SSH server.</string>
