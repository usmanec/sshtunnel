    <string name="radio_saver_title">Aggressive Radio Saver (60 s+ keepalive)</string>
    <string name="radio_saver_desc">Sends SSH keepalives at most once per minute so Wi-Fi/mobile radios wake up less often. Dead connections are detected more slowly.</string>
